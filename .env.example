# Path to the SQLite database file
# On Railway, set this to the mounted volume path, e.g. /data/bussforsinkelser.db
DATABASE_PATH=./data/bussforsinkelser.db

# Path to the GCP service account credentials JSON file
# Used only by the Python pipeline (ingest.py / backfill.py)
GOOGLE_APPLICATION_CREDENTIALS=./gcp-credentials.json

# BigQuery table for Entur SIRI ET data (verify exact name in the Entur data catalog)
# https://data.entur.no/domain/public-transport-data/product/realtime_siri_et
BQ_TABLE=ent-data-sharing-ext-prd.realtime_siri_et.realtime_siri_et_last_recorded

# Log level for the pipeline (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Node server port (default 5000)
PORT=5000

# ---------------------------------------------------------------------------
# Cloudflare R2 (parquet + prod-DB opplasting, kun for pipeline/upload_to_r2.py)
# ---------------------------------------------------------------------------
# Brukes av pipeline/upload_to_r2.py for å laste opp Parquet-uker og en
# strippet prod-DB-kopi til Cloudflare R2. Trengs ikke for å kjøre server
# eller frontend lokalt — kun for daglig pipeline-job.
# Credentials hentes også fra r2.env i prosjektroten hvis filen finnes.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=bussforsinkelser-parquet
R2_PUBLIC_URL=

# Frontend: pek Parquet-fetching mot R2 i prod (settes i Vite build-env).
# Lokalt fungerer det uten — defaulter til /api/parquet via Express.
# VITE_PARQUET_BASE_URL=https://parquet.sentur.no
#
# Bruk R2-custom-domenet, IKKE bøttas pub-xxx.r2.dev-adresse: hele
# .r2.dev-domenet er svartelistet av en del sikkerhets-DNS (bl.a. UiO sin
# RPZ-sinkhole), og oppslaget feiler da før det når Cloudflare.
