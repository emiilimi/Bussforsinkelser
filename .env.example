# Path to the SQLite database file
# On Railway, set this to the mounted volume path, e.g. /data/bussforsinkelser.db
DATABASE_PATH=./data/bussforsinkelser.db

# Path to the GCP service account credentials JSON file
# Used only by the Python pipeline (ingest.py / backfill.py)
GOOGLE_APPLICATION_CREDENTIALS=./gcp-credentials.json

# BigQuery table for Entur SIRI ET data (verify exact name in the Entur data catalog)
# https://data.entur.no/domain/public-transport-data/product/realtime_siri_et
BQ_TABLE=ent-data-sharing-ext-prd.realtime_siri_et.realtime_siri_et_last_recorded

# Log level for the pipeline (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Node server port (default 5000)
PORT=5000
